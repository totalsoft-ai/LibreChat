<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body style="margin: 0; padding: 0; background-color: #f3f4f6; font-family: Arial, sans-serif; color: #1f2937;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding: 24px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%;">
            <tr>
              <td style="background-color: #10a37f; color: #ffffff; padding: 20px 24px; border-radius: 8px 8px 0 0;">
                <h2 style="margin: 0; font-size: 18px;">You have a response to your feedback</h2>
              </td>
            </tr>
            <tr>
              <td style="background-color: #ffffff; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 8px 8px; padding: 24px;">
                <div style="margin-bottom: 16px;">
                  <div style="font-size: 14px;">Dear {{name}},</div>
                  <div style="margin-top: 8px; font-size: 14px;">An administrator has responded to the feedback you submitted in {{appName}}.</div>
                </div>
                <div style="margin-bottom: 16px;">
                  <div style="font-size: 12px; font-weight: bold; color: #6b7280; text-transform: uppercase;">Your feedback</div>
                  <div style="margin-top: 4px; white-space: pre-wrap; color: #6b7280;">{{originalMessage}}</div>
                </div>
                <div style="margin-bottom: 20px;">
                  <div style="font-size: 12px; font-weight: bold; color: #6b7280; text-transform: uppercase;">Response</div>
                  <div style="margin-top: 4px; white-space: pre-wrap;">{{responseText}}</div>
                </div>
                <div style="margin-top: 24px; font-size: 12px; color: #9ca3af;">
                  This is an automated notification from {{appName}}. &copy; {{year}} {{appName}}.
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
